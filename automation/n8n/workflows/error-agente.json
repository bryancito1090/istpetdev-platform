        "url": "={{ ($env.ISTPETDEV_API_BASE_URL || 'http://host.docker.internal:5017/api/v1') + '/agent/runs/by-execution/' + encodeURIComponent(String($('Error Trigger').first().json.execution?.id || '')) }}"
      },
      "position": [
        500,
        300
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5
    },
    {
      "credentials": {
