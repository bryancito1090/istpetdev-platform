        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "jsonBody": "={{ ({ runId: $json.runId, executionId: String($('Error Trigger').first().json.execution.id), workflow: String($('Error Trigger').first().json.workflow.name).slice(0, 100), node: String($('Error Trigger').first().json.execution.lastNodeExecuted || 'unknown').slice(0, 100), message: String($('Error Trigger').first().json.execution.error.message || 'n8n workflow failed').slice(0, 1000) }) }}",
