{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Main": ""
  },
  "Authentication": {
    "Authority": "",
    "AllowedClientIds": [],
    "HumanApiScope": "istpetdev-api/access",
    "TechnicalScope": "istpetdev-api/automation",
    "TechnicalClientIds": []
  },
  "Cors": {
    "Origins": [
      "http://localhost:4200",
      "http://localhost:8100"
    ]
  },
  "Demo": {
    "Enabled": false,
    "FixturePath": "data/fixtures/demo-base",
    "Accounts": []
  },
  "Logistics": {
    "Clock": {
      "Mode": "Dataset"
    },
    "WorkdayStart": "07:00",
    "WorkdayHours": 10,
    "FallbackUtcOffsetHours": -5,
    "DemandWindowDays": 14,
    "DefaultLeadTimeDays": 2,
    "SafetyMarginDays": 3,
    "ConsolidationExtraDays": 3,
    "TargetCoverageDays": 10,
    "SafetyStockUnits": 0,
    "WarehouseSafetyStockPct": 10,
    "StaleStockDays": 7,
    "DefaultWindowStart": "08:00",
    "DefaultWindowEnd": "17:00",
    "DefaultServiceMinutes": 15,
    "DefaultCostPerKm": 0.45,
    "CostPerHour": 6.00,
    "MaxDetourMinutes": 20,
    "ApproxDetourFactor": 1.3,
    "ApproxSpeedKmh": 40,
    "Osrm": {
      "BaseUrl": "",
      "TimeoutSeconds": 3
    }
  },
  "Agent": {
    "TimeoutSeconds": 10,
    "ApiBaseUrl": "http://localhost:5000",
    "N8n": {
      "BaseUrl": "http://localhost:5678",
      "WebhookSecret": "istpetdev-local-hmac-secret-change-in-prod",
      "WatchWebhookPath": "/webhook/agent-watch",
      "IncidentWebhookPath": "/webhook/agent-incident"
    },
    "Policy": {
      "Mode": "AutoWithLimits",
      "MaxCostIncreasePct": 15,
      "MaxDelayMinutes": 60,
      "AutoPublishInitialPlans": false
    }
  }
}
