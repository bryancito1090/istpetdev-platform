# ==============================================================================
# IstpetDev Platform - Plantilla de Entorno Local (.env.example)
# Copia este archivo como '.env' en la raiz del proyecto y define tus valores.
# NOTA: '.env' esta ignorado por Git para proteger credenciales e infraestructura.
# ==============================================================================

# Modo de conexion activo para scripts de ops: 'dev' (AWS EC2) o 'local' (Docker)
DATABASE_MODE=dev

# ------------------------------------------------------------------------------
# 1. Base de Datos Centralizada de Desarrollo (AWS EC2)
# Solicita la IP y contrasena al administrador del equipo por canal privado.
# ------------------------------------------------------------------------------
DATABASE_HOST=tu_host_o_ip_ec2
DATABASE_PORT=5432
DATABASE_NAME=istpetdev_dev_01
DATABASE_USER=migrator_dev_01
DATABASE_PASSWORD=tu_contrasena_de_desarrollo

# ------------------------------------------------------------------------------
# 2. Respaldo Local de Base de Datos (Docker Compose)
# Utilizado al ejecutar: npm run db:local
# ------------------------------------------------------------------------------
LOCAL_DATABASE_HOST=localhost
LOCAL_DATABASE_PORT=15432
LOCAL_DATABASE_NAME=postgres
LOCAL_DATABASE_USER=postgres
LOCAL_DATABASE_PASSWORD=postgres_dev_password_local

# ------------------------------------------------------------------------------
# 3. Cadena de Conexion EF Core para .NET
# Generada o sobreescrita por npm run db:dev / npm run db:local
# ------------------------------------------------------------------------------
ConnectionStrings__Main=Host=tu_host_o_ip_ec2;Port=5432;Database=istpetdev_dev_01;Username=migrator_dev_01;Password=tu_contrasena_de_desarrollo;Include Error Detail=true;
