# Contrato preparatorio; no carga automática y no contiene credenciales reales.
# Completar solo .env privado/user-secrets al implementar API/Compose.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ISTPETDEV_ENVIRONMENT=local

# RDS por túnel SSM: puerto local 15432, Host DNS real mapeado a loopback,
# SSL Mode=VerifyFull y Root Certificate=CA RDS. Credencial por integrante.
ConnectionStrings__Main=
Database__Name=
Database__MigrationConnection=
AWS_REGION=us-east-1
AWS_PROFILE=istpetdev-dev
RDS_DEV_ENDPOINT=
SSM_DEV_INSTANCE_ID=
RDS_LOCAL_PORT=15432

# Solo configuración OIDC pública; ningún client secret para web/PWA.
Authentication__Authority=
Authentication__AllowedClientIds__0=
Authentication__AllowedClientIds__1=
# Tercer ID público reservado al cliente técnico; su secret vive en n8n.
Authentication__AllowedClientIds__2=
Authentication__HumanApiScope=
# Los scopes automation/* se validan por endpoint, aparte del scope humano.
Cors__Origins__0=http://localhost:4200
Cors__Origins__1=http://localhost:8100

# Buckets distintos por entorno/finalidad; usar roles AWS, no access keys aquí.
Storage__EvidenceBucket=
Storage__BackupBucket=
Storage__MaxFileBytes=10485760
Storage__UploadUrlMinutes=5
Storage__DownloadUrlMinutes=15

# n8n remoto existente; Bryan cargará credenciales en el servidor apropiado.
N8N_BASE_URL=https://n8n.bryan-bano.com/
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Solo si se automatiza administración/importación; no autentica nuestra API.
N8N_API_KEY=
# La credencial DeepSeek se carga en n8n; no se requiere en la API local.

# Configuración de deploy futura, no acciones ejecutables desde este archivo.
PUBLIC_WEB_URL=
PUBLIC_MOBILE_URL=
PUBLIC_API_URL=
DOMAIN_NAME=
DEPLOY_DIR=/var/www/istpetdev
BACKEND_IMAGE=
FRONTEND_IMAGE=
RELEASE_ID=

# Credenciales: AWS_PROFILE selecciona el SSO individual de esta máquina.
# No agregar AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY ni AWS_SESSION_TOKEN.
# Obtener DB/tokens dev de Secrets Manager según la guía de la bóveda.
# Guardar valores reales fuera del repo y cargarlos explícitamente a la API.
# Ninguna clave privada debe convertirse en configuración de Angular/PWA.
