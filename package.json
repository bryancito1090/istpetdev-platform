{
  "name": "istpetdev-platform",
  "version": "1.0.0",
  "private": true,
  "description": "IstpetDev - Plataforma logística integral (Expo Clean Ecuador 2026)",
  "workspaces": [
    "libs/shared-core",
    "apps/web",
    "apps/mobile"
  ],
  "engines": {
    "node": "^22.23.3",
    "npm": "10.9.9"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "docker:up": "docker compose -f infra/compose/docker-compose.local.yml up -d",
    "docker:down": "docker compose -f infra/compose/docker-compose.local.yml down",
    "docker:reset": "docker compose -f infra/compose/docker-compose.local.yml down -v && docker compose -f infra/compose/docker-compose.local.yml up -d",
    "db:migrate": "dotnet ef database update --project src/Infrastructure --startup-project src/Api",
    "db:lab": "node scripts/ops/switch-db.mjs lab",
    "db:local": "node scripts/ops/switch-db.mjs local",
    "db:status": "node scripts/ops/switch-db.mjs status",
    "dev:api": "dotnet run --project src/Api",
    "predev:web": "npm run lint:web",
    "dev:web": "npm run start --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "prebuild:web": "npm run lint:web",
    "build:web": "npm run build --workspace=apps/web",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "build:shared": "npm run build --workspace=libs/shared-core",
    "lint": "eslint apps/web/src",
    "lint:web": "eslint apps/web/src",
    "lint:fix": "eslint apps/web/src --fix",
    "check": "npm run check:lint && npm run check:api && npm run check:shared && npm run check:web && npm run check:mobile",
    "check:lint": "npm run lint",
    "check:api": "dotnet build",
    "check:shared": "npm run build:shared",
    "check:web": "npm run build:web",
    "check:mobile": "npm run build:mobile",
    "audit:check": "node .github/scripts/audit-check.mjs"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^23.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "nx": "^23.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "undici": "^7.30.0",
    "handlebars": "^4.7.10"
  }
}
